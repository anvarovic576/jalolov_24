body{
    margin:0;
    font-family:Arial,sans-serif;
    background:linear-gradient(135deg,#001a4d,#000);
    color:white;
}

header{
    text-align:center;
    padding:30px;
    background:#003399;
}

h1{
    color:#FFD700;
    font-size:45px;
    margin:0;
}

p{
    font-size:18px;
}

nav{
    margin-top:20px;
}

nav a{
    color:white;
    text-decoration:none;
    margin:10px;
    font-weight:bold;
}

nav a:hover{
    color:#FFD700;
}

section{
    max-width:900px;
    margin:30px auto;
    padding:20px;
    background:rgba(255,255,255,0.08);
    border-radius:15px;
}

h2{
    color:#FFD700;
}

footer{
    text-align:center;
    padding:20px;
    background:#001133;
}
